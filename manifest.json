{
  "schemaVersion": 1,
  "id": "blr.swarm",
  "name": "Swarm",
  "version": "0.3.2",
  "author": "Bailey Rosen",
  "license": "MIT",
  "description": "A compact session switcher for agents, workspaces, tabs, and shells.",
  "kinds": ["bar-widget"],
  "entryPoints": { "barWidget": "Panel.qml" },
  "barWidget": {
    "displayName": "Swarm",
    "description": "Triage agents and open any workspace, tab, or pane in Herdr or the Collie web dashboard.",
    "category": "AI",
    "aliases": ["swarm", "collie", "herdr", "sessions", "agents"],
    "allowMultiple": false,
    "defaultSection": "left",
    "defaults": {
      "bridgeUrl": "http://127.0.0.1:8787",
      "browserUrl": "http://127.0.0.1:8787",
      "openRefreshSeconds": 2,
      "closedRefreshSeconds": 10,
      "panelWidth": 400,
      "showAttentionCount": true,
      "navigationTarget": "Collie dashboard"
    },
    "schema": [
      { "key": "bridgeUrl", "type": "string", "label": "Session bridge URL", "defaultValue": "http://127.0.0.1:8787", "description": "The local or tailnet URL used to read live session state." },
      { "key": "browserUrl", "type": "string", "label": "Collie browser URL", "defaultValue": "http://127.0.0.1:8787", "description": "The URL opened when you select a pane or space." },
      { "key": "openRefreshSeconds", "type": "integer", "label": "Open refresh (seconds)", "min": 1, "max": 30, "step": 1, "defaultValue": 2 },
      { "key": "closedRefreshSeconds", "type": "integer", "label": "Closed refresh (seconds)", "min": 5, "max": 120, "step": 5, "defaultValue": 10 },
      { "key": "panelWidth", "type": "integer", "label": "Panel width", "min": 320, "max": 560, "step": 10, "defaultValue": 400 },
      { "key": "showAttentionCount", "type": "boolean", "label": "Show attention indicator", "defaultValue": true },
      { "key": "navigationTarget", "type": "enum", "label": "Row navigation", "options": ["Collie dashboard", "Herdr terminal"], "defaultValue": "Collie dashboard", "description": "Choose whether selecting a row opens Collie or focuses that work in Herdr." }
    ]
  }
}
